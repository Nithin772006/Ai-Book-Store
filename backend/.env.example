# Backend Environment Configuration Example
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-in-production
DJANGO_DEBUG=True

# Groq AI Provider (AETHERIUM Book Summaries & AI Reading Assistant)
# Obtain an API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=25.0

# Database Configuration (Supabase PostgreSQL)
# Set DJANGO_USE_SUPABASE=True to activate Supabase PostgreSQL; False to use local SQLite
DJANGO_USE_SUPABASE=True
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_supabase_database_password
SUPABASE_DB_SSLMODE=require
